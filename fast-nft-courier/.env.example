# Copy this file to .env.local and enter values from your Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only secret for future privileged server routes. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
